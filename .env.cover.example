# Local development keeps the current filesystem behavior.
COVER_MONITOR_STORAGE_BACKEND=local
COVER_MONITOR_ASSET_ROOT=runtime/cover_monitor/assets
COVER_MONITOR_STAGING_ROOT=runtime/cover_monitor/staging

# Cloud rollout switches only after OSS smoke tests pass.
# COVER_MONITOR_STORAGE_BACKEND=oss
# COVER_MONITOR_OSS_REGION=cn-hangzhou
# COVER_MONITOR_OSS_ENDPOINT=https://oss-cn-hangzhou-internal.aliyuncs.com
# COVER_MONITOR_OSS_BUCKET=private-bucket-name
# COVER_MONITOR_OSS_PREFIX=cover-monitor/v1
# COVER_MONITOR_OSS_CREDENTIAL_MODE=ecs_ram_role
# COVER_MONITOR_OSS_ECS_ROLE_NAME=role-name

